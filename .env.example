# ---- JEV（TypeSafe System One 协议，经内网 opencode2api 网关）----
JEV_API_URL=http://10.126.126.2:28080/v1/systemone
JEV_API_KEY=
# 网关中的模型 ID：jev-1.13-free（当前使用）/ jev-1.13（付费）；不支持 jev-latest
JEV_MODEL=jev-1.13-free
# JEV_TIMEOUT_MS=8000

# ---- LLM（OpenAI 兼容 chat/completions，填完整 endpoint）----
LLM_API_URL=https://api.deepseek.com/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-flash
# LLM_THINKING=disabled
# LLM_TEMPERATURE=1.0
# LLM_MAX_TOKENS=1500
# LLM_TIMEOUT_MS=25000
# 图片提问（R15，默认关闭）：true 表示 LLM_MODEL 接受图片输入，允许用户附图
# LLM_VISION=false

# ---- 应用 ----
# 不配置对外域名（D45）：Origin 校验、分享图二维码都按用户当前访问的域名，本站有哪些域名由 nginx 的 server_name 决定（13 §5.4）
DATABASE_PATH=./data/chunfeng.db
SHARE_CACHE_DIR=./data/share-cache
# 上传图片的目录（仅 LLM_VISION=true 时写入；Docker 部署固定为数据卷内的 /app/data/images）
# IMAGE_DIR=./data/images
IP_HASH_SALT=change-me
# READING_DEADLINE_MS=50000
# SCORING_STRATEGY=blend
# SCORING_BLEND_WEIGHT=0.6
# SCORING_SOFTMAX_TAU=0.25
# RATE_LIMIT_PER_MIN=8
# RATE_LIMIT_PER_DAY=100
# UPLOAD_RATE_LIMIT_PER_MIN=6
# UPLOAD_RATE_LIMIT_PER_DAY=60
# MAX_CONCURRENT_READINGS=16
# READING_TTL_DAYS=0
# LOG_LEVEL=info

# ---- 开发 ----
# MOCK_UPSTREAMS=false
# MOCK_LATENCY_MS=2500
# MOCK_FAIL=
