{
  "name": "chunfeng",
  "version": "0.1.0",
  "private": true,
  "description": "春风 · 遇事不决，可问春风",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@10.33.0",
  "browserslist": [
    "chrome 111",
    "edge 111",
    "firefox 111",
    "safari 15.4"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:mock": "cross-env MOCK_UPSTREAMS=true next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:upstreams": "tsx scripts/check-upstreams.ts",
    "eval:options": "tsx scripts/eval-options.ts",
    "calibrate:scoring": "tsx scripts/calibrate-scoring.ts",
    "build:fonts": "tsx scripts/build-fonts.ts",
    "build:textures": "tsx scripts/build-textures.ts",
    "build:seal": "tsx scripts/build-seal.ts",
    "build:vision-fixtures": "tsx scripts/build-vision-fixtures.ts",
    "perf:probe": "tsx scripts/perf-probe.ts"
  },
  "dependencies": {
    "@fontsource-variable/noto-serif-sc": "5.3.0",
    "@fontsource-variable/source-serif-4": "5.3.0",
    "better-sqlite3": "13.0.3",
    "nanoid": "6.0.1",
    "next": "16.3.6",
    "pino": "10.3.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.35.4",
    "subset-font": "2.9.0",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "cross-env": "10",
    "pino-pretty": "13.1.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sharp"
    ]
  }
}
